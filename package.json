{
  "name": "andrew-stack-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s build:*",
    "build:remix": "remix vite:build --sourcemapServer",
    "build:server": "esbuild ./server.ts --format=esm --packages=external --platform=node --outdir=build/express --sourcemap --target=node22",
    "dev": "NODE_ENV=development dotenvx run --convention=nextjs -- node --enable-source-maps --inspect ./build/express/server.js",
    "docker": "docker compose up --detach",
    "docker:down": "docker compose down",
    "lint": "eslint --max-warnings 0 .",
    "prisma": "dotenvx run --convention=nextjs -- prisma",
    "prod": "NODE_ENV=production node --enable-source-maps ./build/express/server.js",
    "routes": "remix routes",
    "setup": "prisma generate && npm run prisma migrate deploy && npm run prisma db seed",
    "setup:e2e": "npm run build && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test npm run prisma migrate reset -- --force",
    "storybook": "storybook dev",
    "storybook:build": "storybook build --output-dir ./storybook-static",
    "start": "npm run dev",
    "test": "vitest",
    "test:axe": "npm run storybook:build -- --test && npm run test:axeOnly --",
    "test:axeOnly": "axe-storybook --build-dir ./storybook-static",
    "test:e2e": "npm run setup:e2e && npx playwright test",
    "types": "tsc --noEmit",
    "validate": "run-p \"test -- --run\" lint types"
  },
  "dependencies": {
    "@conform-to/react": "^1.2.0",
    "@conform-to/zod": "^1.2.0",
    "@fontsource/inter": "^5.1.0",
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@remix-run/express": "^2.12.0",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "isbot": "^5.1.17",
    "lucide-react": "^0.441.0",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smart-invariant": "^2.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chanzuckerberg/axe-storybook-testing": "^8.2.0",
    "@dotenvx/dotenvx": "^1.14.1",
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.47.1",
    "@remix-run/dev": "^2.12.0",
    "@remix-run/testing": "^2.12.0",
    "@sinonjs/fake-timers": "^13.0.2",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/eslint": "^8.56.8",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cookie": "^0.6.0",
    "es-module-lexer": "^1.5.4",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^15.7.4",
    "jiti": "^1.21.6",
    "npm-run-all": "^4.1.5",
    "null-loader": "^4.0.1",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.5",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.1"
  },
  "prisma": {
    "seed": "jiti prisma/seed.ts"
  }
}
